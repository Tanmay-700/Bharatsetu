# BharatSetu Configuration
PROJECT_NAME="BharatSetu"
API_V1_STR="/api/v1"
DEBUG=True

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Model configurations
GEMINI_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
RERANKER_MODEL_NAME="BAAI/bge-reranker-v2-m3"

# Vector Database (Local ChromaDB path)
CHROMA_PERSIST_DIRECTORY="./data/vectordb"

# SQLite Async Database URL
DATABASE_URL="sqlite+aiosqlite:///./data/bharatsetu.db"

# Ingestion configuration
UPLOAD_DIR="./data/uploads"
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MAX_BATCH_SIZE=32

# Hardcoded Default User
DEFAULT_USER_ID="user_1"
