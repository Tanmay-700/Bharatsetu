# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
*.env
!.env.example
.env.local
.env.*.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Data, SQLite databases, and logs
backend/data/*.db
backend/data/*.sqlite3
backend/data/vectordb/*
!backend/data/vectordb/.gitkeep
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/*.log
*.log

# Frontend (Node / Vite / React)
frontend/node_modules/
frontend/dist/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
